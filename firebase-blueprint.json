{
  "entities": {
    "family": {
      "title": "Family",
      "description": "Information about registered vulnerable families",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "responsibleName": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["M", "F", "Outro"] },
        "maritalStatus": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "neighborhood": { "type": "string" },
        "municipality": { "type": "string" },
        "rg": { "type": "string" },
        "cpf": { "type": "string" },
        "nisNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["responsibleName", "cpf", "phone"]
    }
  },
  "firestore": {
    "families/{familyId}": {
      "schema": "family",
      "description": "All social assistance nuclei registered by administrators"
    }
  }
}
